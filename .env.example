# PostgreSQL
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MAX_COINS_PER_TRANSACTION=50
TRANSACTIONS_JSON=../data/transactions.json

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# For local Next.js, prefer NEXT_PUBLIC_API_URL=/api and API_PROXY_TARGET=http://127.0.0.1:8000

